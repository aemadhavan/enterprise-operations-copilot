{
  "name": "enterprise-operation-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "eval:fast": "tsx evaluation/runner/cli.ts --tier 1a",
    "eval:model": "tsx evaluation/runner/cli.ts --tier 1b",
    "eval:full": "tsx evaluation/runner/cli.ts --tier 2",
    "validate": "python scripts/validate_seed.py",
    "smoke:models": "tsx scripts/smoke-models.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "1.1.2",
    "@anthropic-ai/sdk": "1.8.0",
    "@aws-sdk/client-bedrock-runtime": "3.1168.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/serverless": "1.2.0",
    "dotenv": "18.0.10",
    "gray-matter": "4.0.3",
    "langfuse": "3.39.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "voyageai": "0.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module"
}
