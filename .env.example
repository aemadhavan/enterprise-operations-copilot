# Model provider: anthropic | bedrock (FR-025)
MODEL_PROVIDER=anthropic

# Anthropic API (when MODEL_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Amazon Bedrock (when MODEL_PROVIDER=bedrock)
# Credentials come from the standard AWS chain (env vars, profile, or role).
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Embeddings (ADR-007): fixed, independent of MODEL_PROVIDER
EMBEDDING_PROVIDER=voyage   # voyage | bedrock (Titan Text Embeddings V2)
EMBEDDING_MODEL=
VOYAGE_API_KEY=

# Eval judge (use a different model from the copilot's)
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=

# Data
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Approval workflow (FR-024b)
APPROVAL_ENGINE=vercel-workflow   # vercel-workflow | in-memory (fallback)
SLA_TIME_SCALE_SECONDS_PER_BUSINESS_DAY=60

# Public demo guardrails
DEMO_DAILY_SPEND_CAP_USD=5
DEMO_RATE_LIMIT_PER_MIN=10
